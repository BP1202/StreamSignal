# ==========================================
# StreamSignal Environment Configuration
# ==========================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=info

# Database Credentials
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432
POSTGRES_HOST=db

# Backend Configuration
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Security and CORS (comma-separated or JSON array)
CORS_ORIGINS=*

# OIDC/Auth0 researcher authentication (required outside development)
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ROLE_CLAIM=https://streamsignal.app/roles
OIDC_RESEARCHER_ROLE=RESEARCHER